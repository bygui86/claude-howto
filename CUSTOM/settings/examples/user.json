{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_ADDITIONAL_DIRECTORIES_CLAUDE_MD": "1",
    "CLAUDE_CODE_EFFORT_LEVEL": "high"
  },
  "permissions": {
    "allow": [
      "Bash(make *)"
    ],
    "deny": [
      "Read(**/.aws/**)",
      "Read(**/.config/**)",
      "Read(**/.docker/**)",
      "Read(**/.gnupg/**)",
      "Read(**/.gpg/**)",
      "Read(**/.gsutil/**)",
      "Read(**/.kube/**)",
      "Read(**/.ssh/**)",
      "Read(**/credentials/**)",
      "Read(**/*kubeconfig*)",
      "Read(**/secrets/**)",
      "Read(**/.env*)",
      "Read(**/.gitconfig)",
      "Read(**/.netrc)",
      "Read(**/*.crt)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pem)",
      "Read(**/*.pfx)",
      "Read(**/*.token)",
      "Read(**/*secret*.yaml)",
      "Read(**/*secret*.yml)",
      "Read(**/*serviceaccount*)",
      "Bash(rm -rf *)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(nc:*)",
      "Bash(ncat:*)",
      "Bash(kubectl get secret*)",
      "Bash(kubectl get secrets*)",
      "Bash(kubectl edit *)",
      "Bash(cat ~/.aws/*)",
      "Bash(cat ~/.config/*)",
      "Bash(cat ~/.docker/*)",
      "Bash(cat ~/.gnupg/*)",
      "Bash(cat ~/.gpg/*)",
      "Bash(cat ~/.gsutil/*)",
      "Bash(cat ~/.kube/*)",
      "Bash(cat ~/.ssh/*)",
      "Bash(cat ~/.gitconfig)",
      "Bash(cat ~/.netrc)",
      "Bash(cat *credentials*)",
      "Bash(cat *secret*)",
      "WebFetch(*)"
    ]
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "voice": {
    "enabled": false
  }
}
